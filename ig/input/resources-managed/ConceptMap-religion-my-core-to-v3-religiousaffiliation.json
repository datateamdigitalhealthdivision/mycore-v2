          "display": "Confucianism",
          "target": [
            {
              "equivalence": "equivalent",
              "code": "1014",
              "display": "Confucianism"
            }
          ]
        },
        {
          "code": "10",
          "display": "Animism",
          "target": [
            {
              "equivalence": "equivalent",
              "code": "1006",
              "display": "Animism"
            }
          ]
        },
        {
          "code": "9",
          "display": "Bahaism",
          "target": [
            {
              "equivalence": "wider",
              "code": "1008",
              "display": "Babi & Baha'I faiths",
              "comment": "The THO concept covers both the Babi and Baha'i faiths; the MOH concept is Baha'i only."
            }
          ]
        },
        {
          "code": "2",
          "display": "Christianity",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "v3-ReligiousAffiliation has no generic Christianity. 1013 is 'Christian (non-Catholic, non-specific)' and would systematically exclude Catholics, a large share of Malaysian Christians."
            }
          ]
        },
        {
          "code": "3",
          "display": "Buddhism",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "v3-ReligiousAffiliation carries Mahayana, Theravada, Vajrayana and Zen but no parent concept for Buddhism."
            }
          ]
        },
        {
          "code": "99",
          "display": "Others",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "No generic 'other' concept exists in v3-ReligiousAffiliation."
            }
          ]
        },
        {
          "code": "0",
          "display": "No Information",
          "target": [
            {
              "equivalence": "unmatched",
              "comment": "Not a religion. Use the FHIR dataAbsentReason pattern, or omit the extension."
            }
          ]
        }
