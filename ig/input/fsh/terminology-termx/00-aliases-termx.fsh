// Aliases hoisted from Chef's per-artefact output by termx-bridge.
// SUSHI errors when one alias name carries two different values across
// the project, so they are defined once here instead of per file.
Alias: $dental-procedure-my-core = https://standards.moh.gov.my/fhir/my-core/CodeSystem/dental-procedure-my-core
Alias: $designation-usage = http://terminology.hl7.org/CodeSystem/designation-usage
Alias: $district-my-core = https://standards.moh.gov.my/fhir/my-core/ValueSet/district-my-core
Alias: $ethnic-my-core = https://standards.moh.gov.my/fhir/my-core/ValueSet/ethnic-my-core
Alias: $imaging-region-my-core = https://standards.moh.gov.my/fhir/my-core/CodeSystem/imaging-region-my-core
Alias: $loinc = http://loinc.org
Alias: $pathology-orderable-my-core = https://standards.moh.gov.my/fhir/my-core/CodeSystem/pathology-orderable-my-core
Alias: $practitioner-role-code-my-core = https://standards.moh.gov.my/fhir/my-core/CodeSystem/practitioner-role-code-my-core
Alias: $radlex = http://radlex.org
Alias: $religion-my-core = https://standards.moh.gov.my/fhir/my-core/ValueSet/religion-my-core
Alias: $task-business-status-my-core = https://standards.moh.gov.my/fhir/my-core/CodeSystem/task-business-status-my-core
Alias: $v3-RoleCode = http://terminology.hl7.org/CodeSystem/v3-RoleCode
