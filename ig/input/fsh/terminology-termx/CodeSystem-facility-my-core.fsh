CodeSystem: FacilityMyCore
Id: facility-my-core
Title: "MOH Healthcare Facility"
Description: "NATIONAL. MOH-maintained healthcare facility register. Codes are opaque identifiers. State, district and facility type are explicit concept properties and are NEVER derived from digits embedded in the code — hospitals and clinics use different district numbering inside the same code format, so derivation produces silently wrong geography. operationalStatus describes the real facility; conceptStatus describes the code's lifecycle. The two are deliberately independent. 21 facilities in Bagan Datuk and Beluru carry NO district property because their district codes (0812, 1339) are proposed by MOH and not yet assigned by JPN."
* ^language = #en
* ^extension.url = "http://hl7.org/fhir/StructureDefinition/cqf-knowledgeRepresentationLevel"
* ^extension.valueCode = #executable
* ^url = "https://standards.moh.gov.my/fhir/my-core/CodeSystem/facility-my-core"
* ^version = "2.1.1"
* ^status = #active
* ^experimental = false
* ^publisher = "Data Team, Digital Health Division, Ministry of Health Malaysia"
* ^caseSensitive = true
* ^content = #complete
* ^property[0].code = #conceptStatus
* ^property[=].description = "Lifecycle of the CODE: active, retired, or experimental (a PROV- provisional code awaiting a permanent one)."
* ^property[=].type = #code
* ^property[+].code = #definition
* ^property[=].description = "Definition"
* ^property[=].type = #string
* ^property[+].code = #display
* ^property[=].uri = "http://terminology.hl7.org/CodeSystem/designation-usage|display"
* ^property[=].description = "Display"
* ^property[=].type = #string
* ^property[+].code = #district
* ^property[=].description = "District code, from district-my-core. Absent where the district code is not yet assigned by JPN."
* ^property[=].type = #code
* ^property[+].code = #facilityType
* ^property[=].description = "Facility type, from facility-type-my-core."
* ^property[=].type = #code
* ^property[+].code = #inactive
* ^property[=].uri = "http://hl7.org/fhir/concept-properties#inactive"
* ^property[=].description = "Inactive"
* ^property[=].type = #boolean
* ^property[+].code = #operationalStatus
* ^property[=].description = "Status of the REAL FACILITY. NOT the concept lifecycle."
* ^property[=].type = #code
* ^property[+].code = #state
* ^property[=].description = "State code. A property, never derived from the facility code."
* ^property[=].type = #code
